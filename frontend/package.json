    "js-cookie": "^3.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.4.0",
    "tailwindcss": "^4.0.14",
    "vite": "^6.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
